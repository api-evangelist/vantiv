{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vantiv Chargeback Authorizations API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authorizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Authorization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://services.vantivprelive.com/services/chargebacks/authorization"
          },
          "docs": "Authorize a card transaction to verify funds availability and place a hold on the cardholder's credit line. Returns an authorization code that must be captured to complete the transaction."
        }
      ]
    }
  ],
  "bundled": true
}